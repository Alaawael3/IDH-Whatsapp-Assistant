# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env -- it's already in .gitignore.
#
# IMPORTANT: if you're setting this up from the old notebook, ROTATE every
# key below first -- they were previously hardcoded in plaintext in a
# notebook that has now been shared outside your control.
# ============================================================

APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Groq LLM -----------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=700
# Smaller/cheaper model used for onboarding/router/query-expansion side chains.
GROQ_UTILITY_MODEL=openai/gpt-oss-120b
GROQ_UTILITY_TEMPERATURE=0.2
OPENROUTER_API_KEY=
# --- Weaviate (knowledge base -- already populated, retrieval-only) -----
WEAVIATE_MODE=cloud
WEAVIATE_URL=zvqwf2c2t8efarsdjynuq.c0.eu-central-1.aws.weaviate.cloud
WEAVIATE_API_KEY=UVRZTEJQTkdiNjQrNGQwaV9WSFk5TnUxdlhmb096eE5LYkcweDhiRzgzNWpkMnAremp3akNHZ2F2Y3pFPV92MjAw
WEAVIATE_LOCAL_HOST=localhost
WEAVIATE_LOCAL_PORT=8080
WEAVIATE_LOCAL_GRPC_PORT=50051
WEAVIATE_EMBEDDED_DATA_PATH=./weaviate_data
WEAVIATE_COLLECTION_NAME=IDHKnowledge

# --- BGE-M3 embeddings ----------------------------------------------------
BGE_MODEL_NAME=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_USE_FP16=false
BGE_MAX_LENGTH=8192
BGE_BATCH_SIZE=12

# --- Retrieval --------------------------------------------------------------
TOP_K=5
MULTI_QUERY_K=10
MULTI_QUERY_FINAL_K=4
MULTI_QUERY_COUNT=3
HYBRID_ALPHA=0.5
RELEVANCE_SCORE_THRESHOLD=0.3
RRF_K=60
HYBRID_QUERY_PROPERTIES=text,test_name,disease_name,branch_name

# --- Mem0 / Qdrant (long-term user memory) -------------------------------
MEM0_LLM_MODEL=llama-3.1-8b-instant
MEM0_EMBEDDING_MODEL=BAAI/bge-m3
MEM0_EMBEDDING_DIMS=1024
MEM0_MAX_MEMORIES_IN_PROMPT=5
MEM0_SEARCH_THRESHOLD=0.3
MEM0_COLLECTION_NAME=idh_user_memories

QDRANT_URL=https://0d9079a2-d47d-4213-a17e-baf1ef992702.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6Y2M2MmExNjAtOGYyOS00MDVmLTk2NTMtNGRkZGMyNGU0MWM0In0.Du2_UuSruJk_PMDa8H7RNJE2kbysx89S1HGWm988q0U
QDRANT_COLLECTION_NAME=idh_user_memories

# --- Short-term memory / session -----------------------------------------
SHORT_TERM_MAX_MESSAGES=5
SESSION_NUDGE_SECONDS=60
SESSION_TIMEOUT_SECONDS=90
# in_memory (single-process only) | redis (not yet implemented, reserved)
SESSION_BACKEND=in_memory
REDIS_URL=

# --- ElevenLabs (voice -- Phase 2) ---------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=scribe_v2

# --- LlamaCloud (documents -- Phase 2) ------------------------------------
LLAMA_CLOUD_API_KEY=

# --- Misc -------------------------------------------------------------------
SHOW_SOURCES_TO_USER=true

HF_HUB_OFFLINE=true

